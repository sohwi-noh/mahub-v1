# 프로젝트 로컬 Codex 훅과 Symphony 트래커가 사용하는 Linear API 토큰입니다.
# 실제 토큰은 .env.local에만 넣고, 예시 파일은 비워 둡니다.
LINEAR_API_KEY=

# Symphony가 Linear 이슈를 가져올 때 사용할 담당자 필터입니다. "me"는 현재 Linear 사용자를 뜻합니다.
LINEAR_ASSIGNEE=me

# 로컬 Symphony 서비스 포트입니다.
SYMPHONY_PORT=4101

# Symphony가 이슈별 작업 워크스페이스를 만드는 루트 디렉터리입니다.
SYMPHONY_WORKSPACE_ROOT=/Users/so2/workspace-so2/mahub-goal/.symphony-workspaces

# 각 Symphony 워크스페이스 안에서 실제 작업 대상이 되는 저장소 디렉터리입니다.
SYMPHONY_TARGET_REPO_DIR=mahub-goal

# 프로젝트 로컬 Codex 작업 로그 훅을 켤 Linear 라벨 목록입니다. 여러 개는 쉼표로 구분합니다.
CODEX_LINEAR_LABELS=codex
