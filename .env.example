# =============================================================================
# Linear
# =============================================================================

LINEAR_API_KEY= # Linear API 토큰입니다. 실제 값은 .env.local에만 둡니다.
LINEAR_ASSIGNEE=me # Symphony가 가져올 Linear 담당자입니다. "me"는 현재 사용자입니다.

# =============================================================================
# Symphony
# =============================================================================

SYMPHONY_PORT=4101 # 로컬 Symphony 포트입니다.
SYMPHONY_WORKSPACE_ROOT= # 이슈별 작업공간 루트입니다. 비우면 run.sh가 현재 checkout 아래 .symphony-workspaces를 사용합니다.
SYMPHONY_TARGET_REPO_DIR=target-repo # 이슈별 작업공간 안의 실제 작업 repo 디렉터리입니다.
SYMPHONY_BRANCH_PREFIX=codex/ # 이슈 작업 브랜치 prefix입니다.

# =============================================================================
# Service Deployment
# =============================================================================

# 실제 서비스 배포/CI/CD 토큰은 서비스별 env 파일이나 배포 환경에 둡니다.
# 예: <SERVICE_NAME>_GITHUB_TOKEN, <SERVICE_NAME>_DEPLOY_TOKEN
# 이 하네스 루트에는 특정 서비스 repo URL이나 단일 서비스 토큰을 고정하지 않습니다.

# =============================================================================
# Codex Hooks
# =============================================================================

CODEX_LINEAR_LABELS=agent-worklog # Codex worklog 훅을 켤 Linear 라벨입니다. 여러 개는 쉼표로 구분합니다.
