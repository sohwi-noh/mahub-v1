# =============================================================================
# Linear
# =============================================================================

# Linear API 토큰입니다. 실제 값은 .env.local에만 둡니다.
LINEAR_API_KEY=

# Symphony가 가져올 Linear 담당자입니다. "me"는 현재 사용자입니다.
LINEAR_ASSIGNEE=me

# =============================================================================
# Symphony
# =============================================================================

# 로컬 Symphony 포트입니다.
SYMPHONY_PORT=4101

# 이슈별 workspace 루트입니다.
SYMPHONY_WORKSPACE_ROOT=/Users/so2/workspace-so2/mahub-goal/.symphony-workspaces

# workspace 안의 실제 작업 repo 디렉터리입니다.
SYMPHONY_TARGET_REPO_DIR=mahub-goal

# 이슈 작업 브랜치 prefix입니다.
SYMPHONY_BRANCH_PREFIX=codex/

# =============================================================================
# GitHub
# =============================================================================

# workspace origin URL입니다. 비우면 root git origin을 사용합니다.
SYMPHONY_TARGET_REPO_URL=

# HTTPS Git 작업용 GitHub 토큰입니다. 실제 값은 .env.local에만 둡니다.
GH_TOKEN=

# 대체 GitHub 토큰 env입니다. GH_TOKEN 또는 GITHUB_TOKEN 중 하나만 사용합니다.
GITHUB_TOKEN=

# 토큰 인증용 HTTPS username입니다.
GITHUB_USERNAME=x-access-token

# SSH remote 사용 시 private key 경로입니다.
SYMPHONY_GITHUB_SSH_KEY=

# =============================================================================
# Codex Hooks
# =============================================================================

# Codex worklog 훅을 켤 Linear 라벨입니다. 여러 개는 쉼표로 구분합니다.
CODEX_LINEAR_LABELS=agent-worklog
