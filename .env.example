# =============================================================================
# Linear
# =============================================================================

# Linear API 토큰입니다. 실제 값은 로컬/개발 secret으로만 주입합니다.
LINEAR_API_KEY=
# Symphony가 가져올 Linear 담당자입니다. "me"는 현재 사용자입니다.
LINEAR_ASSIGNEE=me
# Linear GraphQL API endpoint입니다.
LINEAR_API_ENDPOINT=https://api.linear.app/graphql
# 대시보드에서 열 Linear workspace URL입니다.
LINEAR_WEB_URL=https://linear.app/ktds-ai-eng/

# =============================================================================
# Symphony
# =============================================================================

# 로컬 Symphony 포트입니다.
SYMPHONY_PORT=4101
# 이슈별 작업공간 루트입니다. 비우면 현재 checkout 아래 .symphony-workspaces를 사용합니다.
SYMPHONY_WORKSPACE_ROOT=
# 이슈별 작업공간 안의 실제 작업 repo 디렉터리입니다.
SYMPHONY_TARGET_REPO_DIR=target-repo
# 이슈 작업 브랜치 prefix입니다.
SYMPHONY_BRANCH_PREFIX=codex/

# =============================================================================
# Symphony Usage DB
# =============================================================================

# 세션별 이슈/토큰 사용량을 PostgreSQL에 저장할지 여부입니다.
SYMPHONY_USAGE_DB_ENABLED=false
# 사용량 저장 DB JDBC URL입니다. 인증값은 URL에 넣지 않고 secret env로 주입합니다.
SYMPHONY_USAGE_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/aidd
# 사용량 저장 DB 접속 사용자입니다.
SYMPHONY_USAGE_DB_USERNAME=admin
# AES-256-GCM으로 암호화한 DB 비밀번호입니다.
# 형식은 ENC(v1:aes-256-gcm:<iv_base64>:<ciphertext_base64>:<tag_base64>)입니다.
SYMPHONY_USAGE_DB_PASSWORD='ENC(v1:aes-256-gcm:ZJIaBJFkngGbVrrG:gINFNhIRb7k:MYuu7jh-s_fZsZZ0I7QBKw)'
# DB 비밀번호 복호화 키입니다. 32바이트 base64 또는 hex 값을 secret으로만 주입합니다.
SYMPHONY_SECRET_KEY_BASE64=

# =============================================================================
# Service Deployment
# =============================================================================

# 실제 서비스 배포/CI/CD 토큰은 서비스별 env 파일이나 배포 환경에 둡니다.
# 예: <SERVICE_NAME>_GITHUB_TOKEN, <SERVICE_NAME>_DEPLOY_TOKEN
# 이 하네스 루트에는 특정 서비스 repo URL이나 단일 서비스 토큰을 고정하지 않습니다.

# =============================================================================
# Codex Hooks
# =============================================================================

# Codex worklog 훅을 켤 Linear 라벨입니다. 여러 개는 쉼표로 구분합니다.
CODEX_LINEAR_LABELS=agent-worklog
